{
  "name": "scientific-calculator",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "build:apk:arm64": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a"
  },
  "dependencies": {
    "expo": "~54.0.27",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-edge-to-edge": "~1.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
